# Resend (https://resend.com) — API key with "sending access"
RESEND_API_KEY=
# Where contact messages are delivered. With the default sender below, this must be
# the same email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional until you verify a domain in Resend; defaults to "Portfolio <onboarding@resend.dev>".
# Later: "Matheus Castilho <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Rate limit (2 messages / 30 min per visitor). Free Upstash Redis from the Vercel
# Marketplace adds these automatically; without them the limit is off (fine locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
